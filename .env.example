# Supabase — obter em Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role — NUNCA expor no client (sem NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloudflare Turnstile — site key pública; secret somente no servidor (nunca usar NEXT_PUBLIC_)
# Sem ambas as chaves, o bypass só funciona com NODE_ENV=development; login/cadastro falham fechado fora disso.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CNJ DataJud — api-publica.datajud.cnj.jus.br
# NUNCA expor no client
CNJ_DATAJUD_API_KEY=
CNJ_DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# Webhook secret para Edge Function sync
WEBHOOK_SECRET=

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
