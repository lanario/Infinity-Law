# Supabase — obter em Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role — NUNCA expor no client (sem NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# CNJ DataJud — api-publica.datajud.cnj.jus.br
# NUNCA expor no client
CNJ_DATAJUD_API_KEY=
CNJ_DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# Webhook secret para Edge Function sync
WEBHOOK_SECRET=

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
